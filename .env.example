# Salin ke .env lalu isi nilai yang bertanda WAJIB
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/apkfinal

# WAJIB: secret JWT (min 32 karakter acak untuk produksi)
JWT_SECRET=ganti-dengan-secret-acak-min-32-karakter
ACCESS_TOKEN_EXPIRE_MINUTES=720
REFRESH_TOKEN_EXPIRE_DAYS=14

CORS_ORIGINS=*

# Owner tiap aplikasi (dibuat otomatis saat startup bila belum ada)
HAYLEN_OWNER_USERNAME=owner
HAYLEN_OWNER_PASSWORD=owner123
HAYLEN_OWNER_NAME=Owner Haylen

N6_OWNER_USERNAME=owner
N6_OWNER_PASSWORD=owner123
N6_OWNER_NAME=Owner N6

DBACC_OWNER_EMAIL=owner@dbacc.local.id
DBACC_OWNER_PASSWORD=owner123
DBACC_OWNER_NAME=Owner DB Accounting

DBFIN_OWNER_USERNAME=owner
DBFIN_OWNER_PASSWORD=owner123
DBFIN_OWNER_NAME=Owner DB Finance

CLX_OWNER_USERNAME=owner
CLX_OWNER_PASSWORD=owner123
CLX_OWNER_NAME=Owner Claisrox
