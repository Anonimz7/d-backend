{
  "tier": 4,
  "role": "client",
  "label": "Client",
  "description": "Athlete portal. Own data only, reached through a per-client link. Nothing here exposes another client.",
  "inherits": [],
  "rule": "A user at tier T may use any feature whose tier >= T. Owner (tier 0) therefore reaches everything.",
  "menus": [
    "laporan",
    "performa",
    "chat",
    "sandi"
  ],
  "actions": {
    "own_profile": [
      "view",
      "update"
    ],
    "reports": [
      "view",
      "export"
    ],
    "messages": [
      "view",
      "send"
    ],
    "clients": [],
    "client_schedule": [],
    "coach_schedule": [],
    "attendance": [],
    "programs": [],
    "monitoring": [],
    "corrections": [],
    "athletes": [],
    "pricing": [],
    "tickets": [],
    "commissions": [],
    "finance": [],
    "accounts": []
  },
  "endpoints": {
    "allow": [
      "GET /api/v1/portal/me",
      "PATCH /api/v1/portal/me",
      "GET /api/v1/portal/reports",
      "GET /api/v1/portal/reports/summary",
      "GET /api/v1/portal/messages",
      "POST /api/v1/portal/messages"
    ],
    "deny": [
      "GET /api/v1/clients",
      "GET /api/v1/schedules/*",
      "GET /api/v1/finance/*",
      "GET /api/v1/commissions/*",
      "GET /api/v1/programs",
      "GET /api/v1/accounts",
      "GET /api/v1/monitoring/*"
    ]
  }
}